{
  "extends": "../../packages/tsconfig/nestjs.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "incremental": true,
    "ignoreDeprecations": "5.0",
    "paths": {
      "@ecommerce/shared": ["../../packages/shared/src/index.ts"],
      "@prisma-client": ["./generated/prisma/client"],
      "@prisma-client/*": ["./generated/prisma/client/*"],
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}